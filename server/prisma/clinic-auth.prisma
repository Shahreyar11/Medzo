model ClinicRefreshToken {
  id          String    @id @default(uuid())
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  clinicId    String

  tokenHash   String    @unique
  isRevoked   Boolean   @default(false)
  replacedBy  String?

  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}